# Copie este arquivo para .env e ajuste apenas o necessário.
# Nunca coloque credenciais reais neste arquivo de exemplo.
COQUI_TOS_AGREED=0
DEFAULT_LANGUAGE=pt
MAX_TEXT_CHARS=50000
XTTS_MAX_CHARS=220
CPU_THREADS=6
# API HTTP local e modelo já baixado com ollama pull.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Janela de contexto em tokens e limite de caracteres por seção do material.
LLM_NUM_CTX=4096
LLM_TIMEOUT_SECONDS=600
LLM_MAX_SECTION_CHARS=3200
